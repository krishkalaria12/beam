{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": ["deb", "rpm", "appimage"],
    "externalBin": ["binaries/beam-data-control-server"],
    "resources": [
      "SoulverWrapper/Vendor/SoulverCore-linux/*",
      "SoulverWrapper/Vendor/SoulverCore-linux/SoulverCore_SoulverCore.resources",
      "SoulverWrapper/.build/release/libSoulverWrapper.so",
      "SoulverWrapper/.build/release/swift-linux/*",
      "../../../infra/desktop-integrations/gnome-shell/beam@beam-linux",
      "../../../infra/desktop-integrations/udev/70-beam-snippets.rules"
    ]
  },
  "app": {
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "$HOME/.local/share/icons/**",
            "$HOME/.icons/**",
            "$HOME/.local/**/icons/**",
            "$HOME/.local/share/**/plugins/**",
            "$HOME/.local/share/plugins/**",
            "/usr/share/icons/**",
            "/usr/local/share/icons/**",
            "/usr/share/pixmaps/**",
            "/var/lib/flatpak/exports/share/icons/**",
            "/var/lib/snapd/desktop/icons/**"
          ]
        }
      }
    }
  }
}
